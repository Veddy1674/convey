{
  "name": "convey",
  "displayName": "Convey",
  "description": "Interactive 2D Convolution Visualizer: kernel_size, stride, padding and dilation, tuples support, shapes calculation",
  "version": "1.0.0",
  "license": "MIT",
  "icon": "icon.png",
  "publisher": "veddy1674",
  "homepage": "https://veddy1674.github.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Veddy1674/convey"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Visualization",
    "Data Science",
    "Machine Learning"
  ],
  "keywords": [
    "pytorch",
    "conv2d",
    "convolution",
    "deep learning",
    "neural network",
    "visualizer"
  ],
  "activationEvents": [
    "onWebviewPanel:conveyVisualizer",
    "onLanguage:python"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "convey.open",
        "title": "Open Visualizer",
        "category": "Convey"
      },
      {
        "command": "convey.openFromCursor",
        "title": "Visualize Conv2d Under Cursor",
        "category": "Convey"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "convey.openFromCursor",
          "when": "editorTextFocus && editorLangId == python",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.74.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
